    <node unique_id="30007" name="02 Intelligence Gathering" prog_lang="custom-colors" tags="MnzHack DC-1" readonly="0" nosearch_me="0" nosearch_ch="0" is_bold="0" foreground="" ts_creation="1791003600" ts_lastsave="1791047778">
      <rich_text>Documentar descubrimiento, conectividad, escaneo de puertos y versiones con captura, comando, interpretación y decisión siguiente.</rich_text>
      <node unique_id="30008" name="Descubrimiento de host" prog_lang="custom-colors" tags="MnzHack DC-1" readonly="0" nosearch_me="0" nosearch_ch="0" is_bold="0" foreground="" ts_creation="1791003600" ts_lastsave="1791047778">
        <rich_text>PENDIENTE de ejecución/evidencia propia.</rich_text>
      </node>
